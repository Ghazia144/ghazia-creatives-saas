{
  "rewrites": [
    {
      "source": "/i/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Twitterbot|Discordbot|TelegramBot|LinkedInBot).*"
        }
      ],
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/i/:slug",
      "destination": "/i.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(mp3|mp4|webp|png|jpg|jpeg|gif|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
